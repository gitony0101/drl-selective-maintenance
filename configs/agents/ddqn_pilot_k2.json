{
  "_comment": "Milestone 5 Point-Estimate DDQN Pilot Configuration K=2",
  "_version": "ddqn_pilot_k2",
  "_milestone": "M5",
  "_description": "Bounded pilot run for K=2 verification",

  "environment": {
    "split": "predictor_train",
    "validation_split": "predictor_train",
    "maintenance_capacity": 2,
    "cost_regime_id": "failure-light-no-waste",
    "episode_horizon": 50,
    "scenario_bank_path": "configs/scenarios/m5_pilot_k2.json",
    "prediction_cache_path": "data/processed/fd001/v2/06_PREDICTIONS/"
  },

  "agent": {
    "observation_dim": 10,
    "hidden_dim": 128,
    "num_hidden_layers": 2,
    "learning_rate": 1e-4,
    "gamma": 0.95,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay_steps": 5000,
    "gradient_clip": 10.0,
    "target_update_interval": 500,
    "use_huber_loss": true,
    "huber_delta": 1.0
  },

  "training": {
    "max_steps": 5000,
    "batch_size": 128,
    "warmup_transitions": 500,
    "update_frequency": 1,
    "validation_interval": 5000,
    "checkpoint_interval": 2500,
    "replay_capacity": 10000,
    "training_seed": 6521,
    "validation_seed": 6521
  },

  "output": {
    "output_dir": "results/milestone5/pilot_k2",
    "run_id": null
  },

  "device": {
    "explicit_device": "cpu"
  }
}