{
  "_comment": "Authoritative configuration for FD001 Baseline MSE RUL Predictor",
  "_version": "v2",
  "_description": "Configuration for retrained baseline after normalization fix",

  "seed": 6521,
  "sequence_length": 50,
  "rul_cap": 125,

  "model": {
    "type": "mlp",
    "n_features": 24,
    "hidden_dim": 128,
    "n_layers": 3,
    "dropout": 0.2
  },

  "training": {
    "batch_size": 64,
    "learning_rate": 1e-3,
    "weight_decay": 1e-4,
    "max_epochs": 200,
    "patience": 20,
    "gradient_clipping": 1.0,
    "early_stopping": true
  },

  "loss": {
    "type": "mse",
    "linex_a": 0.1,
    "linex_overflow_threshold": 20.0
  },

  "data": {
    "data_dir": "data/processed/fd001/v2",
    "train_split": "predictor_train",
    "validation_split": "predictor_validation",
    "use_capped_rul": true
  },

  "device": "auto",
  "num_workers": 0,
  "pin_memory": false
}